# Copy to .env.local for development. In Vercel, set these per environment
# (Production AND Preview, or previews can't save leads).

# Canonical site URL used in metadata, sitemap.xml, robots.txt and JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.protomation.ai

# --- Supabase: the Protomation project (auth, leads, button counts) ---
# Create the tables with the files in supabase/, in this order:
#   protomation_enquiries.sql, 2026-11-front-desk-leads.sql, 2026-11-protomation-site-events.sql
# The anon key is public by design: the tables let it INSERT and nothing else.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: record leads and events in a DIFFERENT project from auth.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- New-lead notification (n8n) ---
# POST JSON { event: "lead.created", receivedAt, lead }. Server-only; never commit it.
# Leave empty and leads are only saved to Supabase.
N8N_LEAD_WEBHOOK_URL=
# Sent as the x-protomation-secret header; check it in the n8n Webhook node.
N8N_LEAD_WEBHOOK_SECRET=

# --- Booking, WhatsApp and the demo front desk ---
# Cal.com or Calendly link. Set it and the calendar appears on /contact.
NEXT_PUBLIC_CALENDAR_URL=
# Overrides the WhatsApp number in src/site.config.ts (write it as it should display).
NEXT_PUBLIC_WHATSAPP_NUMBER=
# The demo front desk's phone number. Empty: the site offers public/audio/sample-call.mp3
# if it exists, otherwise points to /how-it-works instead.
NEXT_PUBLIC_DEMO_PHONE=

# --- Google sign-in (unchanged) ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Dormant: Care Plan checkout (its page section is off the site) ---
# The API routes still exist; they answer "not switched on" until these are set.
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_YEARLY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
SUPABASE_SERVICE_ROLE_KEY=
