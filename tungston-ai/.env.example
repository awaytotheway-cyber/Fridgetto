# Canonical site URL used in metadata, sitemap.xml, robots.txt and JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.protomation.ai

# Optional: the n8n webhook the contact form calls, which emails the enquiry on.
# Leave empty to use the production workflow hard-coded in src/app/actions.ts.
# Set it to a rotated webhook path to keep that URL out of this public repo.
# The workflow's webhook node expects GET, so fields are sent as query parameters.
CONTACT_WEBHOOK_URL=

# --- Supabase (one project for everything: auth, enquiries, Care Plan) ---
# The Protomation project. Auth, the contact form's protomation_enquiries table and
# care_subscribers all live here. Create the two tables with the files in supabase/.
# Enable Google OAuth in the Supabase dashboard > Authentication > Providers > Google.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The Web OAuth client ID from Google Cloud Console (Credentials > OAuth client).
# Set this and the Google button signs in with an ID token issued on this page, so
# Google's consent screen says "continue to protomation.ai" instead of naming the
# Supabase project. The client needs the site's origin under "Authorized JavaScript
# origins". Leave it empty and the button falls back to the Supabase OAuth redirect,
# which works but shows <project-ref>.supabase.co on the consent screen.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: record enquiries and subscribers in a DIFFERENT project from auth.
# Leave both empty and the two above are used, which is what you want. The key is
# Supabase's publishable key: the enquiries policy lets it insert only, so reading
# enquiries still needs the service role (the Supabase dashboard).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Care Plan subscriptions (optional; checkout shows "not switched on" until set) ---
# Razorpay (India, INR): create a monthly and a yearly plan in the dashboard
# (Subscriptions > Plans), then add the webhook https://<site>/api/razorpay/webhook
# for subscription.activated/charged/cancelled/halted/completed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_YEARLY=
# Stripe (international): create a monthly and a yearly recurring price, then add the
# webhook https://<site>/api/stripe/webhook for checkout.session.completed and
# customer.subscription.updated/deleted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Server-only. Lets the webhooks write the care_subscribers table (create it with supabase/care_subscribers.sql).
# Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=
