# Canonical site URL used in metadata, sitemap.xml, robots.txt and JSON-LD
NEXT_PUBLIC_SITE_URL=https://tungston.ai

# Emails "Book a free AI audit" submissions. Create a key at https://resend.com/api-keys.
# Without it, and without CONTACT_WEBHOOK_URL below, submissions are only logged on the server.
RESEND_API_KEY=

# Optional: where those emails land. Defaults to protomation.services@gmail.com.
CONTACT_TO_EMAIL=

# Optional: the From address. Defaults to onboarding@resend.dev, which Resend allows without a
# domain but only delivers to the address that owns the Resend account. Once you verify a domain
# with Resend, set this to something like "Tungston.ai <hello@tungston.ai>".
CONTACT_FROM_EMAIL=

# Optional: also post submissions as JSON to a webhook (Slack, Zapier, n8n, Make, CRM…)
CONTACT_WEBHOOK_URL=
